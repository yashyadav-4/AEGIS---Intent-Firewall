# Copy this file to .env and fill values locally.
# AP1..AP5 are used for BuildConfig.GEMINI_API_KEYS in Android.
AP1=
AP2=
AP3=
AP4=
AP5=

# Optional fallbacks if AP1..AP5 are empty
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Optional model overrides
GEMINI_MODEL=gemma-4-31b
GEMINI_VOICE_MODEL=gemini-2.0-flash
